# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-me-in-production-use-a-strong-secret-key
PORT=5001
HOST=127.0.0.1

# Storage Paths
TEMP_STORAGE_DIR=storage/temp
GENERATED_STORAGE_DIR=storage/generated

# File & Download Constraints (in bytes, e.g., 500MB = 524288000)
MAX_FILE_SIZE_BYTES=524288000
DOWNLOAD_TIMEOUT_SECONDS=60
FILE_EXPIRATION_MINUTES=30

# Logging
LOG_LEVEL=INFO

# Cookies for Cloud / Vercel Serverless Deployments (Optional but recommended for Instagram & YouTube)
# Paste Netscape format cookies text or raw cookies string into Vercel Project Settings > Environment Variables
INSTAGRAM_COOKIES=
YOUTUBE_COOKIES=
COOKIES_TEXT=

# Email Delivery Configuration (Gmail SMTP)
# Add these to Vercel Project Settings > Environment Variables to enable email sending on Vercel
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-16-char-gmail-app-password
SMTP_FROM_NAME=LinkForge

